{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "kodi-managed-lab": {
      "mode": "primary",
      "description": "Develop and test add-ons on explicitly authorized disposable managed Kodi",
      "prompt": "Load kodi-mcp-testing and read its everyday managed workflow. Use the authenticated managed tools on the disposable lab. Discover versions, acquire the shared owner and use explicit generations. Use native install for admitted packages, direct deploy for source changes, and named snapshots for reusable profiles. Report verified installation and fresh execution separately. Only Reset with task authorization. Stop or release as the task requires. Keep external Kodi, operator permissions, and publication outside this role.",
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-debugging": "allow",
          "kodi-addon-development": "allow",
          "kodi-addon-validation": "allow",
          "kodi-mcp-testing": "allow",
          "kodi-version-compatibility": "allow"
        },
        "edit": "allow",
        "bash": "ask",
        "kodi_lab_dev_managed_acquire": "allow",
        "kodi_lab_dev_managed_addon_install": "allow",
        "kodi_lab_dev_managed_addon_inventory": "allow",
        "kodi_lab_dev_managed_addon_launch": "allow",
        "kodi_lab_dev_managed_addon_setting": "allow",
        "kodi_lab_dev_managed_gui": "allow",
        "kodi_lab_dev_managed_logs": "allow",
        "kodi_lab_dev_managed_navigate": "allow",
        "kodi_lab_dev_managed_package_import": "allow",
        "kodi_lab_dev_managed_prepare": "allow",
        "kodi_lab_dev_managed_release": "allow",
        "kodi_lab_dev_managed_reset": "allow",
        "kodi_lab_dev_managed_screen": "allow",
        "kodi_lab_dev_managed_skin": "allow",
        "kodi_lab_dev_managed_snapshot_delete": "allow",
        "kodi_lab_dev_managed_snapshot_list": "allow",
        "kodi_lab_dev_managed_snapshot_load": "allow",
        "kodi_lab_dev_managed_snapshot_save": "allow",
        "kodi_lab_dev_managed_start": "allow",
        "kodi_lab_dev_managed_status": "allow",
        "kodi_lab_dev_managed_stop": "allow",
        "kodi_lab_dev_managed_workspace_deploy": "allow",
        "kodi_lab_dev_managed_workspace_edit": "allow",
        "kodi_lab_dev_managed_workspace_open": "allow",
        "kodi_lab_dev_managed_workspace_package": "allow",
        "kodi_lab_dev_managed_workspace_read": "allow",
        "kodi_lab_dev_managed_workspace_tree": "allow"
      }
    }
  }
}
