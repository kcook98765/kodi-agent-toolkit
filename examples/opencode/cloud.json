{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "agent": {
    "kodi-review": {
      "mode": "primary",
      "description": "Select a verified cloud model explicitly after authorization",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "kodi_validate": "allow",
        "kodi_review": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-validation": "allow"
        }
      }
    }
  }
}
