{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "kodi-develop": {
      "mode": "primary",
      "description": "Develop and validate local Kodi add-ons",
      "prompt": "Load kodi-addon-development and the relevant validation and version skills. Work on the requested add-on and preserve its target APIs and manifest. Run release-matched static checks and report incomplete stages.",
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-debugging": "allow",
          "kodi-addon-development": "allow",
          "kodi-addon-validation": "allow",
          "kodi-mcp-testing": "allow",
          "kodi-version-compatibility": "allow"
        },
        "edit": "allow",
        "bash": "ask"
      }
    },
    "kodi-inspect": {
      "mode": "primary",
      "description": "Inspect separately authorized external Kodi targets",
      "prompt": "Load kodi-addon-debugging. Discover the granted external target and use relevant status, UI, bounded logs or an actual screenshot. Report missing evidence. Inspection carries no navigation, source modification or lifecycle authority.",
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-debugging": "allow",
          "kodi-mcp-testing": "allow"
        },
        "kodi_lab_addon_list": "allow",
        "kodi_lab_inspect_ui_state": "allow",
        "kodi_lab_log_read": "allow",
        "kodi_lab_log_scan": "allow",
        "kodi_lab_screenshot_capture": "allow",
        "kodi_lab_system_info": "allow",
        "kodi_lab_target_list": "allow",
        "kodi_lab_target_status": "allow"
      }
    },
    "kodi-support": {
      "mode": "primary",
      "description": "Investigate external Kodi health and logs",
      "prompt": "Load kodi-addon-debugging. Use relevant structured evidence and bounded logs for the exact authorized target. Record what the available diagnostics establish.",
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-debugging": "allow",
          "kodi-mcp-testing": "allow"
        },
        "kodi_lab_addon_list": "allow",
        "kodi_lab_inspect_ui_state": "allow",
        "kodi_lab_log_read": "allow",
        "kodi_lab_log_scan": "allow",
        "kodi_lab_system_info": "allow",
        "kodi_lab_target_list": "allow",
        "kodi_lab_target_status": "allow"
      }
    },
    "kodi-external-develop": {
      "mode": "primary",
      "description": "Develop on explicitly authorized external Kodi development targets",
      "prompt": "Load kodi-mcp-testing and read its external workflow. Use the exact authorized target, workspace and source generation. Verify native application and fresh execution separately. External production and managed profile mutations are outside this role.",
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-debugging": "allow",
          "kodi-addon-development": "allow",
          "kodi-addon-validation": "allow",
          "kodi-mcp-testing": "allow",
          "kodi-version-compatibility": "allow"
        },
        "edit": "allow",
        "bash": "ask",
        "kodi_lab_external_dev_addon_list": "allow",
        "kodi_lab_external_dev_inspect_ui_state": "allow",
        "kodi_lab_external_dev_log_read": "allow",
        "kodi_lab_external_dev_log_scan": "allow",
        "kodi_lab_external_dev_remote_action": "allow",
        "kodi_lab_external_dev_screenshot_capture": "allow",
        "kodi_lab_external_dev_system_info": "allow",
        "kodi_lab_external_dev_target_list": "allow",
        "kodi_lab_external_dev_target_status": "allow",
        "kodi_lab_external_dev_workspace_deploy": "allow",
        "kodi_lab_external_dev_workspace_deploy_preflight": "allow",
        "kodi_lab_external_dev_workspace_execute": "allow",
        "kodi_lab_external_dev_workspace_validate": "allow"
      }
    }
  }
}
