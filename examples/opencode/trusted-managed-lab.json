{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "kodi-managed-lab": {
      "mode": "primary",
      "description": "Explicit opt-in Trusted Managed Lab agent for disposable managed Kodi development, lifecycle and Reset",
      "steps": 75,
      "prompt": "Use only after the operator has explicitly authorized a Trusted Managed Lab task and granted the role to this credential. Load kodi-mcp-testing and its managed-agent-workflow reference, plus the required add-on skill. Discover server schemas. For new sources use project_create or project_import, then owned workspace generation/validation/preflight, direct deployment, manifest launch and real observation. Preserve durable request IDs, exact target/profile/generation and provenance. Start/stop only when needed and authorized. Reset is destructive: require task authorization, observed expected_profile and separately verified Bridge preparation; never Reset to resolve uncertainty. Do not modify permissions, pair devices, contact External Production/Development, bypass human input priority, publish artifacts or treat ZIP delivery as installed. Use only original UUID on uncertain operation replay. Report tested and blocked stages.",
      "permission": {
        "*": "deny",
        "external_directory": "deny",
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "skill": {
          "*": "deny",
          "kodi-addon-development": "allow",
          "kodi-addon-validation": "allow",
          "kodi-addon-debugging": "allow",
          "kodi-version-compatibility": "allow",
          "kodi-mcp-testing": "allow"
        },
        "question": "allow",
        "edit": "allow",
        "todowrite": "allow",
        "bash": "ask",
        "kodi_lab_dev_target_list": "allow",
        "kodi_lab_dev_target_status": "allow",
        "kodi_lab_dev_addon_list": "allow",
        "kodi_lab_dev_inspect_ui_state": "allow",
        "kodi_lab_dev_log_read": "allow",
        "kodi_lab_dev_screenshot_capture": "allow",
        "kodi_lab_dev_screenshot_retrieve": "allow",
